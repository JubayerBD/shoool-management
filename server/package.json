{
  "name": "school-management-server",
  "version": "1.0.0",
  "description": "Bilingual school management REST API (Express + Mongoose)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test test/finance.test.js test/security.test.js test/balance.test.js test/activity.test.js test/features.test.js test/financial-controls.test.js",
    "test:ui": "node test/fees-ui.mjs",
    "test:ui:finance": "node test/profit-ui.mjs",
    "test:ui:school": "node test/school-ui.mjs",
    "test:ui:controls": "node test/controls-ui.mjs",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "mongo:memory": "node src/seed/memory-mongo.js",
    "mongo:local": "node src/seed/local-mongo.js",
    "backup": "node src/seed/backup-cli.js",
    "restore": "node src/seed/restore-cli.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  }
}
