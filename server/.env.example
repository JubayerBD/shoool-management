# Copy to .env and adjust
PORT=5000
NODE_ENV=development

# Use MongoDB Atlas or a local replica set (required for atomic payments).
# The bundled npm run mongo:memory helper starts a single-node replica set.
# For disk-backed local storage: npm run mongo:local, then use
# MONGO_URI=mongodb://127.0.0.1:27018/school_management?replicaSet=school-local
MONGO_URI=mongodb://127.0.0.1:27017/school_management
DATABASE_PERSISTENT=false

# Daily database + upload backups while the API is running.
BACKUPS_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=D:/school-backups  # may point to another disk or mounted backup location

# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Serving the built client from the API (single-service deploy) ---
# SERVE_CLIENT=true
# CLIENT_DIST=../client/dist   # optional override of the built client path

# --- SMS (notice notifications) ---
# SMS_PROVIDER=log             # log (default) | twilio | webhook
# SMS_WEBHOOK_URL=https://your-sms-gateway/send
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1234567890

# --- File storage ---
# local (default) stores under server/uploads; s3 uploads to an S3 bucket.
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3 (also: npm i @aws-sdk/client-s3):
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_PUBLIC_BASE=https://my-bucket.s3.us-east-1.amazonaws.com

# --- Email (notice notifications) ---
# Leave SMTP_HOST unset in dev: emails are logged instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# MAIL_FROM=School Management <no-reply@yourschool.com>
